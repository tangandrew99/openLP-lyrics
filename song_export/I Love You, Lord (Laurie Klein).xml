<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2026-05-31T16:56:51">
  <properties>
    <titles>
      <title>I Love You, Lord</title>
    </titles>
    <authors>
      <author>Laurie Klein</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>I love You, Lord and I lift my voice<br/>To worship You, oh my soul, rejoice<br/>Take joy, my King, in what You hear<br/>May it be a sweet, sweet sound in Your ears</lines>
    </verse>
  </lyrics>
