<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2023-07-14T00:59:27">
  <properties>
    <titles>
      <title>Stand in Awe</title>
    </titles>
    <authors>
      <author>Jon Thurlow</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Lord, I stand, I stand in awe<br/>In awe of You, Jesus</lines>
    </verse>
